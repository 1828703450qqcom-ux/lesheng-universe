# Publish only the application and curated open-source documentation.
# Local audits, deployment records, exports and screenshots may contain private data.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README.en.md
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/package-lock.json
!/.github/
!/client/
!/server/
!/docs/
!/scripts/

/client/*
!/client/src/
!/client/public/
!/client/index.html
!/client/package.json
!/client/package-lock.json
/server/*
!/server/src/
!/server/package.json
!/server/package-lock.json
/docs/*
!/docs/assets/
!/docs/architecture.md
!/docs/deployment.md
!/docs/roadmap.md
!/docs/demo-script.md
!/docs/local-photo-vision.md
/scripts/*
!/scripts/check-publication.mjs
!/scripts/smoke-open-source.mjs
!/scripts/capture-showcase.py

**/node_modules/
**/dist/
**/data/
**/uploads/
**/.env
**/.env.*
!**/.env.example
**/*.log
**/*.head
**/*.bak
**/*.orig
**/*.pem
**/*.key
**/coverage/
**/__pycache__/
**/.DS_Store
**/Thumbs.db
**/.vscode/
**/.idea/
